{%- from "icons.njk" import icon -%}
<section id="cleaning" class="services cleaning-services">
  <div class="container">
    <p class="section-kicker">{{ t.services.eyebrow }}</p>
    <h2>{{ t.services.title }}</h2>
    <p class="section-subtitle">{{ t.services.subtitle }}</p>
    <div class="card-grid">
      {%- for item in t.services.items %}
      <article class="card card-photo">
        <div class="card-photo-media">
          <img src="/assets/img/photos/services/{{ item.image }}" alt="" loading="lazy" width="1000" height="750">
          <div class="card-icon" aria-hidden="true">{{ icon(item.icon) }}</div>
        </div>
        <div class="card-photo-body">
          <h3>{{ item.title }}</h3>
          <p>{{ item.desc }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
