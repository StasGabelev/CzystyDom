<section id="directions" class="business-lines" aria-labelledby="directions-title">
  <div class="container">
    <p class="section-kicker">{{ t.directions.eyebrow }}</p>
    <h2 id="directions-title">{{ t.directions.title }}</h2>
    <p class="section-subtitle">{{ t.directions.subtitle }}</p>
    <div class="business-grid">
      <a class="business-card business-card-cleaning" href="#cleaning">
        <span class="business-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13.5 12 6l8 7.5V21h-6v-5h-4v5H4z"/><path d="m18.5 3 .8 1.7L21 5.5l-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8z"/></svg></span>
        <span class="business-number">01</span>
        <h3>{{ t.directions.cleaning.title }}</h3>
        <p>{{ t.directions.cleaning.desc }}</p>
        <span class="business-link">{{ t.directions.cleaning.link }} <span aria-hidden="true">→</span></span>
      </a>
      <a class="business-card business-card-staffing" href="#staffing">
        <span class="business-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-1a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 21v-3a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v3Zm12-8h2a4 4 0 0 1 4 4v4h-4"/></svg></span>
        <span class="business-number">02</span>
        <h3>{{ t.directions.staffing.title }}</h3>
        <p>{{ t.directions.staffing.desc }}</p>
        <span class="business-link">{{ t.directions.staffing.link }} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>
