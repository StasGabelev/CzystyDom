<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="{{ site.alternates[lang] }}">
      <img class="logo-mark" src="/assets/img/logo-mark.svg" alt="" width="40" height="40">
      {{ site.companyName }}
    </a>

    <nav class="main-nav" data-main-nav aria-label="Main">
      <a href="{{ site.alternates[lang] }}#services">{{ t.nav.services }}</a>
      <a href="{{ site.alternates[lang] }}#why-us">{{ t.nav.whyUs }}</a>
      <a href="{{ site.alternates[lang] }}#process">{{ t.nav.process }}</a>
      <a href="{{ site.alternates[lang] }}#coverage">{{ t.nav.coverage }}</a>
      <a href="{{ site.alternates[lang] }}#contact">{{ t.nav.contact }}</a>
    </nav>

    <div class="header-actions">
      <nav class="lang-switch" aria-label="Language">
        {%- for l, path in site.alternates %}
        <a href="{{ path }}" class="{{ 'is-active' if l == lang }}" hreflang="{{ i18n[l].htmlLang }}">{{ site.langLabels[l] }}</a>
        {%- endfor %}
      </nav>
      <a class="btn btn-primary" href="{{ site.alternates[lang] }}#contact">{{ t.nav.cta }}</a>
      <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
