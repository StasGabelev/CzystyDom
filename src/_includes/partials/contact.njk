<section id="contact" class="contact">
  <div class="container contact-inner">
    <div class="contact-info">
      <h2>{{ t.contact.title }}</h2>
      <p>{{ t.contact.subtitle }}</p>
      <ul class="contact-list">
        <li><a href="{{ site.contact.phoneHref }}">{{ t.contact.phoneLabel }}: {{ site.contact.phoneDisplay }}</a></li>
        <li><a href="{{ site.contact.whatsappHref }}" target="_blank" rel="noopener">{{ t.contact.whatsapp }}</a></li>
        <li><a href="mailto:{{ site.contact.email }}">{{ t.contact.emailLabel }}: {{ site.contact.email }}</a></li>
        <li class="contact-hours">{{ t.contact.hoursLabel }}: {{ t.contact.hours }}</li>
      </ul>
    </div>

    <form class="contact-form" action="/api/contact" method="post" data-contact-form
      data-success="{{ t.contact.form.success }}" data-error="{{ t.contact.form.error }}">
      <label>
        {{ t.contact.form.name }}
        <input type="text" name="name" required>
      </label>
      <label>
        {{ t.contact.form.phone }}
        <input type="tel" name="phone" required>
      </label>
      <label>
        {{ t.contact.form.service }}
        <select name="service">
          <option value="">{{ t.contact.form.choose }}</option>
          <optgroup label="{{ t.contact.form.cleaningGroup }}">
          {%- for item in t.services.items %}
            <option>{{ item.title }}</option>
          {%- endfor %}
          </optgroup>
          <optgroup label="{{ t.contact.form.staffingGroup }}">
          {%- for item in t.staffing.formOptions %}
            <option>{{ item }}</option>
          {%- endfor %}
          </optgroup>
        </select>
      </label>
      <label>
        {{ t.contact.form.message }}
        <textarea name="message" rows="4"></textarea>
      </label>
      <input type="text" name="company_website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="lang" value="{{ lang }}">
      <button type="submit" class="btn btn-primary">{{ t.contact.form.submit }}</button>
      <p class="form-status" data-form-status hidden>
        <span class="form-status-icon" data-form-status-icon aria-hidden="true"></span>
        <span data-form-status-text></span>
      </p>
    </form>
  </div>
</section>
