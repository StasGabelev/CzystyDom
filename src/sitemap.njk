<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for l, path in site.alternates %}
  <url>
    <loc>https://{{ site.domain }}{{ path }}</loc>
  </url>
  <url>
    <loc>https://{{ site.domain }}{{ path }}privacy/</loc>
  </url>
{%- endfor %}
</urlset>
